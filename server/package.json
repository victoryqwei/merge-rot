    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/matter-js": "^0.19.8",
    "@types/node": "^20.5.0",
    "@types/uuid": "^9.0.2",
    "nodemon": "^3.0.1",
